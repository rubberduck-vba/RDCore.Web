<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyTitle>RDCore.Web</AssemblyTitle>
    <Description>Serves RD-VBA class modules as ASP.NET Core endpoints.</Description>
    <!-- the package of this repository. -->
    <IsPackable>true</IsPackable>
    <PackageId>RDCore.Web</PackageId>
    <!-- a framework: its public API is documented, and a public member without an xmldoc fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="RDCore.SDK" Version="$(RDCoreSdkVersion)" />
  </ItemGroup>

</Project>
